generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Subscriber {
  id               String           @id @default(uuid())
  email            String           @unique
  status           SubscriberStatus @default(ACTIVE)
  source           String           @default("website")
  unsubscribeToken String           @unique
  consentAt        DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deliveries       EmailDelivery[]
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

model Issue {
  id            String      @id @default(uuid())
  title         String
  slug          String      @unique
  excerpt       String
  coverImageUrl String?
  bodyMarkdown  String
  bodyHtml      String?
  status        IssueStatus @default(DRAFT)
  issueNumber   Int?
  publishedAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deliveryBatch DeliveryBatch?
}

enum IssueStatus {
  DRAFT
  PUBLISHED
  SENT
  ARCHIVED
}

// One immutable audience and issue snapshot per issue. Never re-enroll subscribers on retry.
model DeliveryBatch {
  id            String          @id @default(uuid())
  issueId       String          @unique
  issue         Issue           @relation(fields: [issueId], references: [id], onDelete: Restrict)
  issueSnapshot Json
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  deliveries    EmailDelivery[]
}

model EmailDelivery {
  id                String         @id @default(uuid())
  batchId           String
  batch             DeliveryBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  subscriberId      String
  subscriber        Subscriber     @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
  email             String
  status            DeliveryStatus @default(PENDING)
  idempotencyKey    String         @unique
  emailPayload      Json
  providerMessageId String?
  lastError         String?
  attempts          Int            @default(0)
  startedAt         DateTime?
  firstAttemptAt    DateTime?
  sentAt            DateTime?
  updatedAt         DateTime       @updatedAt
  createdAt         DateTime       @default(now())

  @@unique([batchId, subscriberId])
  @@index([batchId, status])
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  UNKNOWN
  SKIPPED
}
